<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Create Post</title>
  <link rel="icon" href="/images/postify.png" type="image/png">
  <link rel="stylesheet" href="/styles/navbar.css" />
  <link rel="stylesheet" href="/styles/post.css" />
</head>
<body>

  <!-- Navbar -->
  <%- include('partials/navbar') %>


  <!-- Main Section -->
  <div class="profile-container">
    <form action="/create-post" method="POST" enctype="multipart/form-data" class="post-form">

      <!-- Title -->
      <input
        type="text"
        name="title"
        class="post-title"
        placeholder="Title here..."
        required
      />





      <!-- Description -->
      <textarea
        name="description"
        class="post-description"
        placeholder="What's on your mind?"
        rows="6"
      ></textarea>


    <!-- Media Upload Section -->

    <div class="top-section" style="position: relative; display: inline-block;">
      <label for="photo" class="left-photo clickable-photo">
        
        <img src="/images/media.png" 
          alt="Default Image" 
          class="edit-profile-img" 
          id="profilePic" />

        </label>

        <!-- Remove Button -->
        <button type="button" id="removeImageBtn" class="remove-image-btn">✖</button>

        <input type="file" id="photo" name="media" style="display:none;">
    </div>








      <!-- Submit Button -->
      <div class="btn-wrapper">
        <button type="submit" class="post-btn">Post</button>
      </div>
    </form>
    
  </div>

</body>



  <script>
    let profilePic = document.getElementById("profilePic")
    let inputPic = document.getElementById("photo")
    let deletePic = document.getElementById("removeImageBtn")

    
    inputPic.onchange = function(){
      profilePic.src = URL.createObjectURL(inputPic.files[0])
    }

    deletePic.onclick = function(){
        profilePic.src = "/images/media.png"
        inputPic.value = ""
    }
  </script>

</html>
